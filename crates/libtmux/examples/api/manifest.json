{
  "schemaVersion": 1,
  "language": "rust",
  "nativeInventory": "crates/libtmux/docs/public-api.txt",
  "setupFiles": [
    {
      "sourceFile": "crates/libtmux/examples/api/consumer.toml",
      "name": "Cargo.toml"
    },
    {
      "sourceFile": "rust-toolchain.toml",
      "name": "rust-toolchain.toml"
    }
  ],
  "programFileName": "src/main.rs",
  "runCommand": "cargo run --quiet",
  "examples": [
    {
      "id": "rust-mixed",
      "title": "Capture a pane created synchronously",
      "description": "Create a session with the blocking client, then give its pane key to the Tokio client on the same socket.",
      "sourceFile": "crates/libtmux/examples/api_mixed.rs",
      "cargoExample": "api_mixed",
      "targets": [
        "libtmux_blocking::Server::new_session",
        "libtmux_core::CreatedSession::pane",
        "libtmux_tokio::Server::capture"
      ],
      "expectedOutput": "mixed runtime"
    }
  ]
}
